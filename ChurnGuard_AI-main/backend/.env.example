# ==========================================
# ChurnGuard AI - Backend Environment Template
# ==========================================

APP_ENV=development
APP_NAME=ChurnGuard AI
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production-min-32-chars

# Database: SQLite for local dev, PostgreSQL for production
# DATABASE_URL=postgresql://user:password@localhost:5432/churnguard
DATABASE_URL=sqlite:///./churnguard.db

# Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Security & CORS
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# File Storage
UPLOAD_DIR=./storage/uploads
MODEL_DIR=./storage/models
MAX_UPLOAD_SIZE_MB=25
